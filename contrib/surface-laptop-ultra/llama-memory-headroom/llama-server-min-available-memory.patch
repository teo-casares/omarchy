         notify_status(SERVER_MODEL_STATUS_UNLOADED, {{"exit_code", 1}});
         clean_up();
         ctx_http.join();
-        SRV_ERR("%s", "exiting due to model loading error\n");
+        if (admission_error.empty()) {
