diff --git c/tools/server/server-memory-admission.h w/tools/server/server-memory-admission.h
new file mode 100644
index 00000000..88649f83
--- /dev/null
+++ w/tools/server/server-memory-admission.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <istream>
+#include <sstream>
+#include <string>
+#include <string_view>
+
+inline std::string server_check_model_memory(std::string_view minimum, std::istream & meminfo) {
+    if (minimum.empty()) {
+        return {};
+    }
+
+    uint64_t required_mib = 0;
+    const auto end = minimum.data() + minimum.size();
+    const auto parsed = std::from_chars(minimum.data(), end, required_mib);
+    if (parsed.ec != std::errc{} || parsed.ptr != end || required_mib == 0) {
+        return "LLAMA_SERVER_MIN_AVAILABLE_MIB must be a positive integer";
+    }
+
+    for (std::string line; std::getline(meminfo, line);) {
+        if (line.rfind("MemAvailable:", 0) != 0) {
+            continue;
+        }
+
+        uint64_t available_kib;
+        std::string field, amount, unit, extra;
+        std::istringstream entry(line);
+        if (!(entry >> field >> amount >> unit) || field != "MemAvailable:" || unit != "kB" || (entry >> extra)) {
+            break;
+        }
+        const auto amount_end = amount.data() + amount.size();
+        const auto available = std::from_chars(amount.data(), amount_end, available_kib);
+        if (available.ec != std::errc{} || available.ptr != amount_end) {
+            break;
+        }
+
+        const uint64_t available_mib = available_kib / 1024;
+        if (available_mib < required_mib) {
+            return "model load deferred: " + std::to_string(available_mib) +
+                   " MiB available, requires " + std::to_string(required_mib) + " MiB";
+        }
+        return {};
+    }
+
+    return "cannot read MemAvailable from /proc/meminfo";
+}
