# Based on Arch Linux's gnome-keyring 1:51.1-1 package.
pkgname=gnome-keyring
pkgver=51.1
pkgrel=1.1
epoch=1
pkgdesc="Stores passwords and encryption keys"
url="https://gitlab.gnome.org/GNOME/gnome-keyring"
arch=(aarch64 x86_64)
license=(GPL-2.0-or-later LGPL-2.1-or-later)
depends=(dconf gcr gcr-4 glib2 glibc libcap-ng libgcc libgcrypt pam systemd-libs)
makedepends=(docbook-xsl glib2-devel meson p11-kit python)
checkdepends=(dbus)
provides=(org.freedesktop.secrets)
groups=(gnome)
install=gnome-keyring.install
source=(
  "https://download.gnome.org/sources/gnome-keyring/${pkgver%%.*}/gnome-keyring-$pkgver.tar.xz"
  0001-daemon-Add-Cinnamon-to-autostart-files.patch
  0002-secret-service-open-session.patch
)
sha256sums=(
  'dfe7adc5876ef0670e7eba2907799bdbb8875ce58bb4208e1a52169bd16a47ca'
  '138ad9a41dcbf9faede3a8b7fcb61dd5894ca8b66599802e58f8bb81e9607eb2'
  'b78cc55c40623a1ce5f1f328218296cc0d0a41acdb09b4acd264accce22594e1'
)

prepare() {
  cd "gnome-keyring-$pkgver"
  patch -Np1 -i ../0001-daemon-Add-Cinnamon-to-autostart-files.patch
  patch -Np1 -i ../0002-secret-service-open-session.patch
}

build() {
  arch-meson "gnome-keyring-$pkgver" build -D selinux=disabled
  meson compile -C build
}

check() {
  dbus-run-session meson test -C build --suite gkr-daemon-dbus --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
